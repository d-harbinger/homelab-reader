# Reverse proxy configuration — copy to .env in this directory and fill in.
# The real .env is not committed; it holds site-specific values.

# The DNS zone the app names live in. The Caddyfile builds every site address
# from it: reader.<zone>, dashboard.<zone>, kitchen.<zone>, and so on.
#
# Pick a zone that is NOT the zone the coordination endpoint uses, and not a
# publicly-resolvable one unless the intent is public certificates. The mesh's
# own MagicDNS base domain is the natural choice, because names under it
# already resolve on every enrolled device.
PROXY_ZONE=

# The host interface the proxy publishes 443 on. Required — compose refuses to
# start without it, because a published port bypasses the host firewall and the
# bind address is therefore the firewall.
#
#   0.0.0.0      reachable from the local network AND over the mesh. Choose this
#                when local-network clients (a desktop, a kiosk) need the apps.
#   <mesh-addr>  the services host's own mesh address: reachable ONLY by
#                enrolled devices, subject to the mesh access policy. Tighter,
#                and it makes local-network clients mesh members or nothing.
PROXY_BIND=
