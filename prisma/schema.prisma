// homelab-reader — initial schema
//
// Design notes:
// - SQLite via Prisma, mirroring chimera's pattern.
// - Books are discovered by filesystem scan; the source of truth for a
//   book's location is its `filePath` (absolute or relative to BOOKS_PATH).
//   `fileHash` lets us detect renames vs new files without re-importing
//   notes/progress.
// - Notes and Highlights are anchored differently per format:
//     EPUB → EPUB CFI (canonical fragment identifier)
//     PDF  → page index + selection bounds
//   We store both via a single Anchor JSON blob; the reader-side helper
//   parses it according to the parent Book's format.
// - Progress is per-User+Book. Single-user today, but the User table is
//   real so a future "share with household" doesn't require migration.
// - ScanLocation lets the user point at multiple folders later
//   (e.g. /books + /reference) without code changes.
// - OpdsToken is a per-user API credential for OPDS clients (android-reader
//   and standard readers), which authenticate with HTTP Basic/Bearer rather
//   than the web cookie session. The plaintext token is NEVER persisted:
//   we store only its SHA-256 hex (`tokenHash`) and look the row up by that,
//   per docs/OPDS-AUTH-CONTRACT.md. The token is shown to the user exactly
//   once at mint time. No plaintext token column exists by design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  // "admin" can manage other users; "reader" can only use the library.
  // The first account created (via first-run setup) is the admin.
  role         String     @default("reader")
  createdAt    DateTime   @default(now())

  progress     Progress[]
  notes        Note[]
  highlights   Highlight[]
  inkStrokes   InkStroke[]
  opdsTokens   OpdsToken[]
}

// Per-user OPDS API token ("app password"). Hashed at rest: `tokenHash` is the
// SHA-256 hex of the opaque base64url token; the plaintext is never stored and
// never logged (docs/OPDS-AUTH-CONTRACT.md). Look up by `tokenHash`, then a
// constant-time compare confirms the row before it is trusted.
model OpdsToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  label      String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Book {
  id            String    @id @default(cuid())
  filePath      String    @unique
  fileHash      String?
  fileSizeBytes Int?
  format        String    // "epub" | "pdf"

  title         String
  subtitle      String?
  language      String?
  publisher     String?
  publishedAt   DateTime?
  description   String?
  isbn          String?

  // Cover stored on disk under /data/covers/<id>.<ext>
  coverPath     String?

  // EPUB-specific: total pages we estimated for progress %
  // PDF-specific:  pdfjs page count
  pageCount     Int?

  addedAt       DateTime  @default(now())
  scannedAt     DateTime  @default(now())

  authors       Author[]  @relation("BookAuthors")
  tags          Tag[]     @relation("BookTags")
  notes         Note[]
  highlights    Highlight[]
  inkStrokes    InkStroke[]
  progress      Progress[]
  suggestions   BookSuggestion[]

  @@index([title])
  @@index([format])
}

// A ranked metadata candidate proposed for a Book at scan time (D3 enrich-on-
// import). One row per OpenLibrary candidate; created best-effort when a freshly
// imported book is "thin" (src/lib/metadata/enrich.ts → isThin). Deliberately
// named BookSuggestion, NOT MetadataSuggestion: the latter is the in-memory
// search-result interface in src/lib/metadata/openlibrary.ts, and the scan hook
// MAPS that shape onto these columns (authors/subjects are string[] in memory →
// JSON-encoded String here, since SQLite has no array type). The owner reviews
// pending rows and accepts the best match, which writes the chosen fields back
// onto the Book (applyAcceptance) and marks the siblings rejected.
model BookSuggestion {
  id            String   @id @default(cuid())
  bookId        String
  source        String   // "openlibrary"
  confidence    Float
  title         String?
  authors       String   // JSON string[] (SQLite has no array)
  publishedYear Int?
  publisher     String?
  isbn          String?
  subjects      String   // JSON string[]
  coverUrl      String?
  workKey       String?  // OpenLibrary /works/OL…W — stable handle
  status        String   @default("pending") // pending | accepted | rejected
  createdAt     DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status])
}

model Author {
  id    String @id @default(cuid())
  name  String @unique
  books Book[] @relation("BookAuthors")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  books Book[] @relation("BookTags")
}

model Progress {
  id         String   @id @default(cuid())
  bookId     String
  userId     String
  // Last anchor reached. Same JSON shape as Note/Highlight.anchor.
  anchor     String?
  percent    Float    @default(0)
  updatedAt  DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
}

model Note {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  // JSON: { type: "epub-cfi", cfi: "..." } or { type: "pdf-point", page, x, y }
  anchor    String
  // Quoted text snippet near the anchor (helps if anchor breaks later)
  context   String?
  body      String
  // Optional FK to the highlight this note annotates (Slice 2b). SetNull, NOT
  // Cascade: deleting a highlight orphans the note (the text is the user's),
  // it never deletes it. Absent for freeform/book-level notes and legacy data,
  // which keep pairing via the CFI fallback in src/lib/annotations.ts.
  highlightId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlight Highlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([highlightId])
}

model Highlight {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  // JSON: { type: "epub-cfi-range", cfiStart, cfiEnd }
  //   or  { type: "pdf-rect", page, rects: [...] }
  anchor    String
  text      String
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Inverse of Note.highlight — the notes structurally bound to this highlight.
  notes Note[]

  @@index([bookId])
}

// A single freehand ink stroke drawn over a PDF page (the reader's Draw tool).
// Per-user, like Highlight. One row per stroke keeps erase/undo trivial.
model InkStroke {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  page      Int
  // JSON: { points: [[x, y, pressure], ...] } in page-fraction coords (0..1),
  // so a stroke scales with the page at any zoom — same model as pdf-rect
  // highlights. Pressure is 0..1 (0.5 for devices that don't report it).
  path      String
  color     String   @default("#1c1c1e")
  // 4 matches what the API and toolbar actually default to (the old 6 was
  // never used — every create passes an explicit width).
  width     Float    @default(4)
  // 0..1 stroke opacity; backfills existing rows to fully opaque, so strokes
  // saved before the field existed render exactly as they always did.
  opacity   Float    @default(1)
  // "pen" or "highlighter". Backfills existing rows to "pen", so strokes saved
  // before the instrument split render exactly as they always did.
  kind      String   @default("pen")
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, userId])
}

model ScanLocation {
  id        String   @id @default(cuid())
  path      String   @unique
  enabled   Boolean  @default(true)
  lastScan  DateTime?
  createdAt DateTime @default(now())
}

// A book file the scanner saw but could not extract (corrupt archive, missing
// OPF, unreadable PDF). Recorded so a malformed book is a visible signal in
// the UI instead of silently vanishing. Unique by filePath: the watcher
// upserts on each failed (re)scan and deletes the row once the path imports
// successfully or is removed. The stored `error` is truncated; full paths stay
// server-side (the UI surfaces basename + reason only — Plan 02).
model FailedImport {
  id        String   @id @default(cuid())
  filePath  String   @unique
  format    String   // "epub" | "pdf"
  error     String
  createdAt DateTime @default(now())
}
