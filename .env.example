# Copy to .env and edit. .env is gitignored.
#
# Every active line in this template has a working value. One variable is
# REQUIRED and is deliberately left commented out: HOMELAB_HOST_BIND, the
# publish address (see the "Host port + interface" block below). Copying this
# template therefore cannot quietly supply a network default — compose refuses
# to start until the answer is recorded. `./launch.sh` asks for it once and
# writes it here.

# Where the SQLite database lives. In Docker this is bind-mounted to /data.
# SQLite paths in Prisma resolve relative to the schema file's directory,
# so `../data/...` from prisma/schema.prisma lands at project-root/data/.
#
# ?connection_limit=1 — SQLite allows only one writer at a time. With a
# background scanner writing while readers save notes/progress, multiple Prisma
# connections fight over the write lock and surface "database is locked". A
# single pooled connection serializes writers so the app waits in line instead
# of erroring (paired with WAL + busy_timeout applied at boot).
DATABASE_URL="file:../data/homelab-reader.db?connection_limit=1"

# Filesystem path the scanner watches for books. In Docker this is the
# host's library, bind-mounted read-only at /books.
BOOKS_PATH="./books"

# Root the admin filesystem picker (Settings -> Libraries) is jailed to: it
# may browse this directory and its subfolders, nothing above or outside it.
# Requests that try to escape return the same opaque error as a missing folder,
# so the picker can't be used to probe the rest of the server's filesystem.
# If unset, the jail falls back to /app/books (the container's library mount)
# when it exists, otherwise the home directory (so the picker works in
# development). Set this to lock browsing to a specific library root.
# FS_BROWSE_ROOT="/app/books"

# Host port + interface the container is published on (Docker maps these to the
# container's internal port 3000). Default host port is 5456, following the
# sibling service scheme: chimera 5454, chef-calc-pro 5455, homelab-reader 5456.
#
# HOMELAB_HOST_BIND is the real access control: a Docker-published port bypasses
# the host firewall, so the interface it binds to is what limits who can reach
# the app. It is REQUIRED — compose refuses to start until it is set, so the
# choice is always deliberate (./launch.sh asks once and saves it here). Use
# 127.0.0.1 for loopback — the machine itself only, e.g. behind a reverse
# proxy. To serve other devices on the local network — the usual homelab case,
# e.g. feeding android-reader over OPDS — set it to 0.0.0.0 (all interfaces).
HOMELAB_PORT="5456"
# Left commented out ON PURPOSE. The compose file writes this mapping in the
# required-variable form (${HOMELAB_HOST_BIND:?…}), which exists so that a
# deployment cannot inherit a publish address nobody chose. Shipping a value
# here would defeat exactly that: copying the template would silently answer
# the question. Uncomment one of the two lines below, or let ./launch.sh
# write the answer.
# HOMELAB_HOST_BIND="127.0.0.1"
# HOMELAB_HOST_BIND="0.0.0.0"

# NextAuth secret. Generate with: openssl rand -base64 32
# If unset, the app generates and persists one on first run (dev only).
AUTH_SECRET=""

# Listen URL — leave as-is unless deploying behind a reverse proxy.
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
