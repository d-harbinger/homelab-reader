# Copy to .env and edit. .env is gitignored.

# Where the SQLite database lives. In Docker this is bind-mounted to /data.
# SQLite paths in Prisma resolve relative to the schema file's directory,
# so `../data/...` from prisma/schema.prisma lands at project-root/data/.
#
# ?connection_limit=1 — SQLite allows only one writer at a time. With a
# background scanner writing while readers save notes/progress, multiple Prisma
# connections fight over the write lock and surface "database is locked". A
# single pooled connection serializes writers so the app waits in line instead
# of erroring (paired with WAL + busy_timeout applied at boot).
DATABASE_URL="file:../data/homelab-reader.db?connection_limit=1"

# Filesystem path the scanner watches for books. In Docker this is the
# host's library, bind-mounted read-only at /books.
BOOKS_PATH="./books"

# NextAuth secret. Generate with: openssl rand -base64 32
# If unset, the app generates and persists one on first run (dev only).
AUTH_SECRET=""

# Listen URL — leave as-is unless deploying behind a reverse proxy.
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
