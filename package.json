{
  "name": "homelab-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "node scripts/preflight.mjs",
    "predev": "node scripts/ensure-env.mjs && node scripts/preflight.mjs && prisma generate && prisma migrate deploy && node scripts/copy-pdfjs-worker.mjs",
    "dev": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "dev:webpack": "next dev",
    "prebuild": "prisma generate && node scripts/copy-pdfjs-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "dom-anchor-text-quote": "^4.0.2",
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.14.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "pdf-to-img": "^6.1.0",
    "pdfjs-dist": "^5.6.205",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-pdf": "^10.4.1",
    "swr": "^2.4.0",
    "yauzl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.18",
    "fast-check": "^4.9.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "@xmldom/xmldom": "^0.8.13",
    "vite": "^8.0.16",
    "js-yaml": "^4.2.0",
    "minimatch@^3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@^10": {
      "brace-expansion": "^5.0.9"
    }
  }
}
